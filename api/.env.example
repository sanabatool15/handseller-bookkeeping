# --- SQL Server (pyodbc) ---
# Option A: full ODBC string (wins if set)
MSSQL_CONNECTION_STRING=
# Option B: parts (empty MSSQL_USER = Windows auth / Trusted_Connection)
MSSQL_SERVER=localhost
MSSQL_DATABASE=HandsellerDB
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUST_SERVER_CERTIFICATE=1

# --- Auth / JWT ---
JWT_SECRET=change-me-super-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Idempotency (answers are remembered in the SQL Server table idempotency_keys) ---
IDEMPOTENCY_TTL_SECONDS=86400

APP_ENV=development
LOG_LEVEL=INFO

# --- Transaction log / DB Lab (demo layer, slice F5) ---
# Calls slower than this are logged as "lock_wait_suspected" (INFERRED from elapsed time, not observed).
LOCK_WAIT_SUSPECT_MS=300
# Demo-only concurrency lab (race, deadlock): keep false outside a classroom demo. When false every /db-lab route is 404.
ENABLE_DB_LAB=false
