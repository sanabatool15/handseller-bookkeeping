# Supabase project connection settings
# Find these in your Supabase project: Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# Use the service_role key for server-side/backend access (keep secret, never expose to clients).
# You may use the anon key instead if you rely solely on Row Level Security policies.
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# CORS: comma-separated list of allowed origins for the frontend(s) that call this API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# App environment: development | staging | production
APP_ENV=development

# Host/port used when running `python -m app.main` locally (uvicorn also reads these)
APP_HOST=0.0.0.0
APP_PORT=8000
