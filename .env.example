# --- Frontend (Next.js, read at the repo root) ---
# Same-origin in production (frontend and backend are one Vercel project,
# backend reachable under /api). Override only for pointing at a different
# backend during local dev.
NEXT_PUBLIC_API_URL=/api

# --- Backend (FastAPI, in api/ -- see api/.env.example for the full list) ---
# Copy api/.env.example to api/.env for local backend development; Vercel
# reads these from the dashboard's Environment Variables, not from a file.
